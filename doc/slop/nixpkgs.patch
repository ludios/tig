+    # Also let `set diff-syntax-filter = tig-syntax-filter` resolve without
+    # the profile's bin on PATH.
     wrapProgram $out/bin/tig \
-      --suffix PATH ':' "${git}/bin"
+      --suffix PATH ':' "${git}/bin:$out/bin"
   '';
 
