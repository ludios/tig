+// Model-output: Claude Fable 5
+
+/**
+ * BENCH: shared mutable counters for the instrumented benchmark build
+ * (BM4/BM10).  Not part of the shipped daemon.  Counters only ever
+ * increase; consumers snapshot and diff.
+ */
+
+export const stats: Record<string, number> = {
+	blob_cache_hit: 0,
+	blob_cache_miss: 0,
+	blob_batch_null: 0,
+	batcher_spawn: 0,
+	toplevel_call: 0,
+	toplevel_spawn: 0,
+	textconv_call: 0,
+	textconv_spawn: 0,
+	worktree_read: 0,
+	line_cache_hit: 0,
+	line_cache_short: 0,
+	line_cache_miss: 0,
+	tokenize_call: 0,
+	tokenize_ms: 0,
+	tokenize_line: 0,
+	lang_load: 0,
+};
+
+/** Snapshot the counters. */
+export function snapshot(): Record<string, number> {
+	return { ...stats };
+}
+
+/** Per-key difference `now - base`, omitting zeros. */
+export function diff_since(base: Record<string, number>): Record<string, number> {
+	const out: Record<string, number> = {};
+	for (const [k, v] of Object.entries(stats)) {
+		const d = v - (base[k] ?? 0);
+		if (d !== 0) {
+			out[k] = Math.round(d * 100) / 100;
+		}
+	}
+	return out;
+}
