#!/bin/sh
#
# Model-output: Claude Opus 5.5
#
# Graph test: time per row grows linearly with the graph's width
#
# 20000 commits, up to ~2500 lanes wide.  On a fast 2026 machine test-graph
# takes ~1.6 s of CPU time here (~3.2 s built with -O0); when each row cost
# O(W²), it took ~60 s.  The limit is 20 s.

. libtest.sh

if [ "${TIG_ADDRESS_SANITIZER_ENABLED:-no}" = yes ]; then
	test_skip "The address sanitizer's overhead makes a fixed CPU limit meaningless"
fi
test_setup

gen-history 20000 1 20000 > input

(
	ulimit -t 20 2>/dev/null || true
	code=0
	test-graph < input > /dev/null || code="$?"
	echo "exit status $code"
) > status 2>&1

assert_equals status strict "test-graph used over 20 s of CPU time or failed" <<EOF
exit status 0
EOF
