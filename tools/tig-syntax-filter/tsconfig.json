{
	"$schema": "https://json.schemastore.org/tsconfig",
	"include": ["src/**/*.ts", "src/**/*.mjs", "scripts/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
	"compilerOptions": {
		"module": "nodenext",
		// Not esnext: node runs src/ without transpiling it, so allow only the
		// ECMAScript built-ins that the oldest supported node (23.6, per README.md) has
		"target": "es2024",
		"lib": ["es2024"],
		"types": ["node"],

		"noEmit": true,
		"skipLibCheck": true,

		"allowImportingTsExtensions": true,
		"noUncheckedSideEffectImports": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		// Typecheck src/start.mjs too, which is plain JavaScript on purpose (see its header)
		"allowJs": true,
		"checkJs": true,

		"strict": true,
		// node runs src/ by stripping types, which needs erasable syntax
		"erasableSyntaxOnly": true,
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": true,
		"noFallthroughCasesInSwitch": true,
	}
}
