{
	"name": "tig-syntax-filter",
	"version": "0.1.0",
	"description": "Syntax-highlighting diff filter daemon for tig (shiki / vscode-textmate)",
	"type": "module",
	"private": true,
	"license": "GPL-2.0-or-later",
	"scripts": {
		"lint": "oxlint",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.18.0",
			"onFail": "download"
		}
	},
	"dependencies": {
		"@logtape/file": "2.4.2",
		"@logtape/logtape": "2.4.2",
		"ayy": "5.0.1",
		"shiki": "4.6.0"
	},
	"devDependencies": {
		"@logtape/lint": "2.4.2",
		"@types/node": "^26.6.6",
		"fast-check": "4.10.2",
		"oxlint": "1.93.0",
		"oxlint-tsgolint": "7.0.2007",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
	}
}
